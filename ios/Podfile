# iOS Minimum version for all ProofIt packages
# Apple requires MinimumOSVersion 15.0+ for App Store Connect uploads from Spring 2027.
platform :ios, '15.0'

# CocoaPods analytics sends network stats synchronously affecting your build speed.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug'   => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end
  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig and running flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!
  use_modular_headers!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))

  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      # Required for geolocator + camera on iOS 13+
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
    end
  end

  # Razorpay ships prebuilt xcframeworks (Razorpay/RazorpayCore/RazorpayStandard)
  # with a correct dSYM bundled alongside each binary slice. Xcode only
  # auto-collects dSYMs for code it compiles itself, so for these vendored
  # dynamic frameworks the dSYMs never make it into the archive on their own —
  # copy them into DWARF_DSYM_FOLDER_PATH so the archive picks them up.
  installer.aggregate_targets.each do |aggregate_target|
    aggregate_target.user_project.native_targets.each do |native_target|
      next unless native_target.name == 'Runner'

      phase_name = 'Copy Vendored Pod dSYMs'
      next if native_target.shell_script_build_phases.any? { |p| p.name == phase_name }

      phase = native_target.new_shell_script_build_phase(phase_name)
      phase.shell_script = <<~SCRIPT
        if [ -n "${DWARF_DSYM_FOLDER_PATH}" ]; then
          mkdir -p "${DWARF_DSYM_FOLDER_PATH}"
          find "${PODS_ROOT}" -path "*/ios-arm64/dSYMs/*.dSYM" -exec cp -R {} "${DWARF_DSYM_FOLDER_PATH}/" \\;
        fi
      SCRIPT
    end
    aggregate_target.user_project.save
  end
end
